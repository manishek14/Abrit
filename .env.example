# ============================================================================
# AbrIT Ticketing System — environment template
# Copy this file to `.env` and adjust:   cp .env.example .env
# Real secrets must never be committed to the repository.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=3000
CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Tehran

# --- Database ---------------------------------------------------------------
# With docker compose: postgres://abrit:abrit@127.0.0.1:5432/abrit
DATABASE_URL=postgres://abrit:abrit@127.0.0.1:5432/abrit
# Run pending migrations automatically on boot (idempotent)
MIGRATIONS_RUN=true
# Seed demo data (Persian sample users/tickets/messages) when the DB is empty
SEED_DEMO_DATA=true

# --- Auth / first admin (REQUIRED — change in production) -------------------
# No default is provided for JWT_SECRET on purpose; the app refuses to boot without it.
JWT_SECRET=change-me-to-a-long-random-string-32-chars
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@abrit.local
ADMIN_PASSWORD=Admin1234!

# --- Telegram (INTENTIONALLY EMPTY FOR NOW) ---------------------------------
# The project owner will provide the real token later. While TELEGRAM_BOT_TOKEN
# is empty the Telegram integration stays disabled and only logs an info message.
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_UPDATES=message

# --- OpenRouter / AI (INTENTIONALLY EMPTY FOR NOW) --------------------------
# The project owner will provide the API key later. While OPENROUTER_API_KEY is
# empty the assistant replies with a fixed fallback message instead of calling
# the provider (nothing leaves the machine).
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/auto
OPENROUTER_TIMEOUT_MS=25000
AI_CONTEXT_MAX_MESSAGES=20
AI_MAX_CONCURRENCY=3
AI_MAX_OUTPUT_TOKENS=500
AI_CONTEXT_MAX_CHARS=21000
