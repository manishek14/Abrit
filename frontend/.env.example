# AbrIT Admin Panel (frontend) — environment template
# Copy to .env:  cp .env.example .env
# Vite exposes ONLY VITE_* variables to the client bundle — never put secrets here.

# REST API base URL baked into the bundle at build time.
# Unset → http://localhost:3000/api
VITE_API_URL=http://localhost:3000/api

# Socket.IO base URL.
# Unset (dev) → http://localhost:3000
# For production builds set it to the empty string so the socket connects to
# the same origin that serves the panel (nginx proxies /api and /socket.io —
# see nginx.conf).
# VITE_WS_URL=
